# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ⚠️ ห้ามอัปไฟล์ .env.local ขึ้น GitHub (มีใน .gitignore แล้ว)

# รหัสเข้าหน้า /admin — ต้องยาวอย่างน้อย 12 ตัว ไม่งั้นหน้า admin จะไม่ยอมให้เข้า
# สุ่มรหัสได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=

# (ไม่บังคับ) กุญแจเซ็น cookie ของ admin ถ้าไม่ใส่จะสร้างจาก ADMIN_PASSWORD ให้เอง
SESSION_SECRET=

# 🔐 กุญแจเข้ารหัสข้อความที่เก็บในฐานข้อมูล (AES-256-GCM) — บน Vercel ต้องใส่
# ฐานข้อมูลหลุดก็อ่านข้อความไม่ออก | ⚠️ ทำกุญแจหาย = อ่านข้อความเก่าไม่ได้อีกเลย ให้เก็บสำรองไว้
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_KEY=

# 🚪 (ไม่บังคับ) รหัสก่อนเข้าเว็บ ถ้าใส่ ทุกหน้าต้องใส่รหัสนี้ที่ /unlock ก่อน (จำไว้ 30 วัน)
# ใช้อะไรที่แฟนรู้แต่คนอื่นเดายาก ยาวอย่างน้อย 8 ตัว ไม่ใส่ = ไม่มีหน้าใส่รหัส
SITE_PASSCODE=
# MongoDB — ต้องใส่เมื่อขึ้น Vercel (ในเครื่องไม่ใส่ก็ได้ จะเก็บที่ data/messages.json)
# ตัวอย่าง: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=love-web

# (ไม่บังคับ) ส่งข้อความใหม่เข้าอีเมลผ่าน Resend (ส่งผ่าน HTTPS/TLS)
# สมัครที่ resend.com ด้วยอีเมลเดียวกับ NOTIFY_EMAIL → API Keys → Create API Key
RESEND_API_KEY= 
NOTIFY_EMAIL=
# (ไม่บังคับ) ใส่เมื่อยืนยันโดเมนของตัวเองกับ Resend แล้ว เช่น Love Web <love@yourdomain.com>
NOTIFY_FROM=

# (ไม่บังคับ) true = อีเมล/Discord แจ้งแค่ว่ามีข้อความใหม่ ไม่ใส่เนื้อหา (อ่านที่ /admin เท่านั้น)
NOTIFY_HIDE_MESSAGE=false

# (ไม่บังคับ) แจ้งเตือนข้อความใหม่ผ่าน Discord
DISCORD_WEBHOOK_URL= 
